        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://mazestudio.site/</loc>
    <xhtml:link rel="alternate" hreflang="es"        href="https://mazestudio.site/"/>
    <xhtml:link rel="alternate" hreflang="en"        href="https://mazestudio.site/en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://mazestudio.site/"/>
    <lastmod>2026-07-31</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://mazestudio.site/en</loc>
    <xhtml:link rel="alternate" hreflang="es"        href="https://mazestudio.site/"/>
    <xhtml:link rel="alternate" hreflang="en"        href="https://mazestudio.site/en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://mazestudio.site/"/>
    <lastmod>2026-07-31</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <!-- Páginas legales: se añadirán cuando se publiquen (tras el alta de autónomo). -->
</urlset>
